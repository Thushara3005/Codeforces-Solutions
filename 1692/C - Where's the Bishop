#include<bits/stdc++.h>
using namespace std;
 
int main() {
  int t;
  cin>>t;
  while(t--){
      vector<string> v(8);
      for(int i=0;i<8;i++){
          cin>>v[i];
      }
      for(int i=1;i<=6;i++){
          for(int j=1;j<=6;j++){
              if(v[i-1][j-1]=='#' && v[i-1][j+1]=='#' && v[i+1][j-1]=='#' && v[i+1][j+1]=='#'){
                  cout<<i+1<<" "<<j+1<<endl;
                  break;
              }
          }
      }
  }
  return 0;
}