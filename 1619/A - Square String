#include<bits/stdc++.h>
using namespace std;
 
int main() {
    int t;
    cin>>t;
    while(t--){
        string s;
        cin>>s;
        if(s.size()%2==1){
            cout<<"NO"<<endl;
        }
        else{
            int a=s.size()/2;
            string k=s.substr(0,a);
            string p=s.substr(a,s.size());
            if(k==p){
                cout<<"YES"<<endl;
            }
            else{
                cout<<"NO"<<endl;
            }
        }
    }
  
  return 0;
}